<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:SourceGit.Converters"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="450"
             x:Class="SourceGit.Views.RepositorySidebar"
             x:DataType="vm:RepositorySidebar">
  <Grid RowDefinitions="28,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="16,*,Auto" Margin="8,0,0,0">
      <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Repositories}" Fill="{DynamicResource Brush.FG2}"/>
      <TextBlock Grid.Column="1" Classes="group_header_label" Text="REPOSITORIES" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
        <Button Classes="icon_button" Width="22" Click="OnOpenLocalRepository" ToolTip.Tip="{DynamicResource Text.Welcome.OpenOrInit}">
          <Path Width="12" Height="12" Data="{StaticResource Icons.Folder.Open}"/>
        </Button>
        <Button Classes="icon_button" Width="22" Click="OnCloneRepository" ToolTip.Tip="{DynamicResource Text.Welcome.Clone}">
          <Path Width="12" Height="12" Data="{StaticResource Icons.Clone}"/>
        </Button>
        <Button Classes="icon_button" Width="22" Click="OnCreateGroup" ToolTip.Tip="{DynamicResource Text.Welcome.AddRootFolder}">
          <Path Width="12" Height="12" Data="{StaticResource Icons.Folder.Add}"/>
        </Button>
      </StackPanel>
    </Grid>

    <TextBox Grid.Row="1"
             Margin="6,0,4,4"
             Height="24"
             Padding="0"
             CornerRadius="13"
             BorderBrush="{DynamicResource Brush.Border2}"
             BorderThickness="1"
             Watermark="{DynamicResource Text.Welcome.Search}"
             VerticalContentAlignment="Center"
             Text="{Binding SearchFilter, Mode=TwoWay}">
      <TextBox.InnerLeftContent>
        <Path Width="14" Height="14" Margin="6,0,0,0" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
      </TextBox.InnerLeftContent>
      <TextBox.InnerRightContent>
        <Button Classes="icon_button"
                Width="16"
                Margin="0,0,6,0"
                IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Click="OnClearSearchFilter">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Clear}" Fill="{DynamicResource Brush.FG1}"/>
        </Button>
      </TextBox.InnerRightContent>
    </TextBox>

    <ListBox Grid.Row="2"
             x:Name="RowsList"
             Margin="6,0,4,0"
             Background="Transparent"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnDragOver"
             DragDrop.Drop="OnDropOnList"
             ContextRequested="OnListContextRequested"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
             SelectionMode="Single"
             KeyDown="OnRowsKeyDown">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Height" Value="24"/>
          <Setter Property="MinHeight" Value="24"/>
        </Style>
      </ListBox.Styles>

      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>

      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:RepositorySidebarRow">
          <Grid Background="Transparent"
                Height="24"
                ColumnDefinitions="16,20,*,Auto"
                Margin="{Binding Depth, Converter={x:Static c:IntConverters.ToTreeMargin}}"
                ToolTip.Tip="{Binding Path}"
                Tapped="OnRowTapped"
                ContextRequested="OnRowContextRequested"
                PointerPressed="OnRowPointerPressed"
                PointerMoved="OnRowPointerMoved"
                PointerReleased="OnRowPointerReleased"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="OnDragOver"
                DragDrop.Drop="OnDropOnRow">
            <ToggleButton Grid.Column="0"
                          Classes="tree_expander"
                          Focusable="False"
                          HorizontalAlignment="Center"
                          IsChecked="{Binding IsExpanded, Mode=OneWay}"
                          IsVisible="{Binding CanExpand}"
                          Click="OnToggleClicked"/>

            <Path Grid.Column="1" Width="13" Height="13" HorizontalAlignment="Left"
                  Data="{StaticResource Icons.Folder}" Fill="{DynamicResource Brush.FG1}"
                  IsVisible="{Binding IsGroup}"/>
            <Path Grid.Column="1" Width="13" Height="13" HorizontalAlignment="Left"
                  Data="{StaticResource Icons.Folder}"
                  Fill="{Binding Node.Bookmark, Mode=OneWay, FallbackValue={x:Null}, Converter={x:Static c:IntConverters.ToBookmarkBrush}}"
                  IsVisible="{Binding IsGroup}"/>
            <v:Bookmark Grid.Column="1" Width="13" Height="13" HorizontalAlignment="Left"
                        Value="{Binding Node.Bookmark, Mode=OneWay, FallbackValue=0}"
                        IsVisible="{Binding IsRepository}"/>
            <Path Grid.Column="1" Width="12" Height="12" HorizontalAlignment="Left"
                  Data="{StaticResource Icons.Submodule}" Fill="{DynamicResource Brush.FG2}"
                  IsVisible="{Binding IsSubmodule}"/>

            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,6,0">
              <Ellipse Width="7" Height="7" Fill="DarkOrange" IsVisible="{Binding IsSubmoduleDirty}"/>
              <ContentControl Content="{Binding Node.Status, Mode=OneWay, FallbackValue={x:Null}}">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="m:RepositoryStatus">
                    <StackPanel Orientation="Horizontal">
                      <Border Margin="2,0"
                              Height="16"
                              CornerRadius="8"
                              Padding="5,0"
                              Background="{DynamicResource Brush.FG1}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding LocalChanges, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                        <TextBlock Text="{Binding LocalChanges}"
                                   FontFamily="{DynamicResource Fonts.Monospace}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Window}"/>
                      </Border>
                      <TextBlock Margin="2,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding TrackingDescription}"
                                 FontFamily="{DynamicResource Fonts.Monospace}"
                                 FontSize="11"
                                 Foreground="{DynamicResource Brush.FG2}"
                                 IsVisible="{Binding IsTrackingStatusVisible}"/>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
