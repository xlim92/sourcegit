<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <Style Selector="Button.labeled">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
    </Style>
    <Style Selector="Button.labeled Path">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
    </Style>
    <Style Selector="Button.labeled:disabled">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.labeled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,0,Auto">
    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,0,0,0" ClipToBounds="True">
      <Button Classes="labeled" Tapped="Pull" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.CtrlClickTip}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Pull}"/>
            <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Green"
                     IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="label" Text="Pull ⌄"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="Sync" IsVisible="{Binding !IsBare}" ToolTip.Tip="Pull, then Push">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Pull}" Margin="0,0,6,0"/>
            <Path Width="12" Height="12" Data="{StaticResource Icons.Push}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>
          <TextBlock Classes="label" Text="Sync"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Tapped="Push" ToolTip.Tip="{DynamicResource Text.CtrlClickTip}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Push}"/>
            <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Green"
                     IsVisible="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="label" Text="Push ⌄"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="FetchAll" ToolTip.Tip="Fetch all remotes">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Fetch}"/>
          </Grid>
          <TextBlock Classes="label" Text="Fetch All"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="ShowCommit" IsVisible="{Binding !IsBare}" ToolTip.Tip="Local Changes / Commit">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Commit}"/>
          </Grid>
          <TextBlock Classes="label" Text="Commit"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="ShowConflicts" IsVisible="{Binding !IsBare}" IsEnabled="{Binding WorkingCopy.HasUnsolvedConflicts, FallbackValue=False}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Conflict}"/>
          </Grid>
          <TextBlock Classes="label" Text="Conflict Solver"/>
        </StackPanel>
      </Button>
      <Rectangle Width="1" Height="30" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Border2}"/>
      <Button Classes="labeled" Command="{Binding CreateNewTag}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Tag.Add}"/>
          </Grid>
          <TextBlock Classes="label" Text="Add Tag"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Branch.Add}"/>
          </Grid>
          <TextBlock Classes="label" Text="Add Branch"/>
        </StackPanel>
      </Button>
      <Rectangle Width="1" Height="30" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Border2}"/>
      <Button Classes="labeled" Tapped="StashAll" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.CtrlClickTip}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Stashes.Add}"/>
          </Grid>
          <TextBlock Classes="label" Text="Stash"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Apply.Title}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.ApplyPatch}"/>
          </Grid>
          <TextBlock Classes="label" Text="Patch"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="OpenGitFlowMenu" IsVisible="{Binding !IsBare}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.GitFlow}"/>
          </Grid>
          <TextBlock Classes="label" Text="Git-Flow"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="OpenGitLFSMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitLFS}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.LFS}"/>
          </Grid>
          <TextBlock Classes="label" Text="LFS"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="StartBisect" IsVisible="{Binding !IsBare}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Bisect}"/>
          </Grid>
          <TextBlock Classes="label" Text="Bisect"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="OpenCustomActionMenu" ToolTip.Tip="{DynamicResource Text.Repository.CustomActions}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Action}"/>
          </Grid>
          <TextBlock Classes="label" Text="Actions"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="Cleanup" ToolTip.Tip="{DynamicResource Text.Repository.Clean}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Clean}"/>
          </Grid>
          <TextBlock Classes="label" Text="Cleanup"/>
        </StackPanel>
      </Button>
      <Rectangle Width="1" Height="30" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Border2}"/>
      <Button Classes="labeled" Click="OpenWithExternalTools" ToolTip.Tip="{DynamicResource Text.Repository.OpenWithExternalTools}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.OpenWith}"/>
          </Grid>
          <TextBlock Classes="label" Text="Open ⌄"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="OpenGitLogs" ToolTip.Tip="{DynamicResource Text.Repository.ViewLogs}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Logs}"/>
          </Grid>
          <TextBlock Classes="label" Text="Logs"/>
        </StackPanel>
      </Button>
      <Button Classes="labeled" Click="OpenStatistics" ToolTip.Tip="{DynamicResource Text.Repository.Statistics}">
        <StackPanel>
          <Grid Width="22" Height="20" HorizontalAlignment="Center">
            <Path Width="16" Height="16" Data="{StaticResource Icons.Statistics}"/>
          </Grid>
          <TextBlock Classes="label" Text="Statistics"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <Grid Grid.Column="2" HorizontalAlignment="Right" ColumnDefinitions="Auto,Auto,32,32,6">
      <Path Grid.Column="0"
            Width="13" Height="13"
            Margin="18,0,0,0"
            Data="{StaticResource Icons.Branch}"/>

      <Border Grid.Column="1"
              Margin="6,0"
              Background="Transparent"
              ToolTip.Tip="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}">
        <TextBlock Text="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"/>
      </Border>

      <Button Grid.Column="2"
              Classes="icon_button"
              Width="32"
              Click="NavigateToHead"
              ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <Path Width="14" Height="14"
              Margin="0,1,0,0"
              Data="{StaticResource Icons.Target}"/>
      </Button>

      <ToggleButton Grid.Column="3"
                    Classes="line_path"
                    Width="32"
                    IsChecked="{Binding FocusOnCurrentBranch, Mode=TwoWay}"
                    ToolTip.Tip="{DynamicResource Text.Repository.FocusOnCurrentBranch}">
        <ToggleButton.Styles>
          <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="400"/>
          </Style>
        </ToggleButton.Styles>
        
        <Path Width="14" Height="14"
              Data="{StaticResource Icons.Magic}"/>
      </ToggleButton>
    </Grid>
  </Grid>
</UserControl>
